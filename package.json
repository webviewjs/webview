{
  "name": "webviewjs",
  "homepage": "https://webview.js.org",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && bun --filter @webviewjs/examples check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write . && cargo fmt --manifest-path packages/webview/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path packages/webview/Cargo.toml -- --check",
    "check": "turbo run check",
    "clippy": "turbo run clippy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md,mdx,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "^0.13.2",
    "prettier": "^3.9.6",
    "turbo": "^2.11.6"
  }
}
