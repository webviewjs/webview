{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "build:lib": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "check": {},
    "clippy": {
      "cache": false
    },
    "@webviewjs/webview#build": {
      "cache": false
    },
    "@webviewjs/webview#test": {
      "cache": false
    }
  }
}
